PORT=8080
NODE_ENV=production
APP_URL=https://publisher.convertlyfiles.com/
PUBLIC_VIEWER_BASE_URL=https://flipviewpdf.com
DATABASE_URL=./data/flipview.db

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_secure_random_refresh_secret_key_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30

# Upload Configuration
UPLOAD_CHUNK_SIZE=2097152
UPLOAD_SESSION_TTL_MINUTES=30

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID=your_cloudflare_r2_account_id
R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
R2_BUCKET_NAME=flipview-pdfs
R2_PUBLIC_URL=https://your-public-r2-subdomain.r2.dev

# Google Blogger API Integration (Optional)
BLOGGER_BLOG_ID=5830475951713053686
BLOGGER_CLIENT_ID=your_google_oauth_client_id
BLOGGER_CLIENT_SECRET=your_google_oauth_client_secret
BLOGGER_REFRESH_TOKEN=your_google_oauth_refresh_token
BLOG_DOMAIN=flipviewpdf.blogspot.com

# Email Publishing Fallback (Optional)
RESEND_API_KEY=re_your_resend_api_key
BLOGGER_POST_EMAIL=your_secret_blogger_email@blogger.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_smtp_email@gmail.com
SMTP_PASS=your_smtp_app_password

# Admin Security & Legacy Access Key
ADMIN_API_KEY=replace_with_secure_admin_api_key_for_maintenance

# Optional: GitHub Migration
GITHUB_REPO=technews1562/flipbook-pdfs
GITHUB_TOKEN=your_github_personal_access_token